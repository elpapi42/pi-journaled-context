{
  "name": "pi-journaled-context",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Journaled Context Memory: short-term memory for Pi Durable that keeps a conversation going without limit, by editing the context entry by entry and keeping a journal of what happened",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/chord": "^1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-durable": "^1.5.2"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-codemode": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
